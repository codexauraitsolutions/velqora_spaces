# Copy to .env.local for local dev, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# Firebase → Project settings → General → Your apps → Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Analytics 4 → Admin → Data streams → Web → Measurement ID (G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Feedback photo uploads (AWS S3). Server-only — NO VITE_ prefix, never commit real values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# Public CloudFront address the photos are shown from, e.g. https://d1abc2xyz.cloudfront.net
VITE_PHOTOS_CDN_URL=
